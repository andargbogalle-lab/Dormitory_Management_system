@model List<dprmitory.Models.Student>

@{
    ViewData["Title"] = "Present Students";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-check text-success"></i> Present Students</h2>
        <div>
            <a asp-action="AbsentStudents" class="btn btn-danger">
                <i class="bi bi-person-x"></i> View Absent Students
            </a>
            <a asp-action="StudentStatus" class="btn btn-primary">
                <i class="bi bi-list"></i> View All Students
            </a>
            <a asp-action="Dashboard" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <div class="alert alert-success" role="alert">
        <i class="bi bi-check-circle-fill"></i> 
        <strong>Summary:</strong> @ViewBag.TotalPresent out of @ViewBag.TotalStudents students are currently present
        (@(((double)ViewBag.TotalPresent / ViewBag.TotalStudents * 100).ToString("F1"))%)
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i> No students are marked as present.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5><i class="bi bi-check-circle"></i> Present Students List</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Student ID</th>
                                <th>Full Name</th>
                                <th>Room</th>
                                <th>Department</th>
                                <th>Phone</th>
                                <th>Check-In Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model)
                            {
                                <tr>
                                    <td>@student.StudentId</td>
                                    <td>@student.FullName</td>
                                    <td>
                                        @if (student.Room != null)
                                        {
                                            <span class="badge bg-info">@student.Room.RoomNumber</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Assigned</span>
                                        }
                                    </td>
                                    <td>@student.Department</td>
                                    <td>@student.Phone</td>
                                    <td>
                                        <span class="badge bg-@(student.IsCheckedIn ? "success" : "secondary")">
                                            @(student.IsCheckedIn ? "Checked In" : "Not Checked In")
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-secondary" onclick="markAbsent(@student.Id, '@student.FullName')">
                                            <i class="bi bi-x-circle"></i> Mark Absent
                                        </button>
                                        <a asp-controller="Student" asp-action="Details" asp-route-id="@student.Id" class="btn btn-sm btn-info">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-primary" onclick="window.print()">
                <i class="bi bi-printer"></i> Print Present List
            </button>
            <button class="btn btn-secondary" onclick="exportToCSV()">
                <i class="bi bi-file-earmark-spreadsheet"></i> Export to CSV
            </button>
        </div>
    }
</div>


