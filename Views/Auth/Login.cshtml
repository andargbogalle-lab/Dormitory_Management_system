@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login – Dormitory Management</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="login-page">
    <div class="login-card">
        <div class="login-header">
            <span class="login-icon">🏠</span>
            <h1>Dormitory Management</h1>
            <p>Sign in to your account</p>
        </div>
        <div class="login-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">❌ @TempData["Error"]</div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">✅ @TempData["Success"]</div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="role">Login As</label>
                    <select name="role" id="role" required>
                        <option value="">— Select Role —</option>
                        <option value="Director">🏛 Director</option>
                        <option value="Proctor">👮 Proctor</option>
                        <option value="Student">🎓 Student</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="username">Username / Student ID</label>
                    <input type="text" name="username" id="username" placeholder="Enter your username" required />
                    <small>Letters only for staff · Alphanumeric for students</small>
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" name="password" id="password" placeholder="Enter your password" required />
                    <small>Enter your assigned password</small>
                </div>
                <button type="submit" class="btn btn-primary btn-block btn-lg">Sign In</button>
                <a href="/" class="btn btn-secondary btn-block" style="margin-top:10px;">← Back to Home</a>
            </form>
        </div>
    </div>
</div>
</body>
</html>
