@model dprmitory.Models.Student

@{
    ViewData["Title"] = "Register Student";
}

<div class="page-header">
    <h1>➕ Register Student</h1>
    <a asp-action="Index" class="btn btn-secondary">← Back to Students</a>
</div>

<div class="alert alert-info">
    💡 A unique 6-character alphanumeric password will be auto-generated after registration. Share it with the student so they can log in using their Student ID.
</div>

<form asp-action="Register" method="post" class="form-card">
    <div class="form-row">
        <div class="form-group">
            <label asp-for="StudentId">Student ID</label>
            <input asp-for="StudentId" placeholder="e.g., STU001" />
            <span asp-validation-for="StudentId" class="error-message"></span>
            <small>Letters and numbers only</small>
        </div>
        <div class="form-group">
            <label asp-for="FullName">Full Name</label>
            <input asp-for="FullName" placeholder="e.g., John Doe" />
            <span asp-validation-for="FullName" class="error-message"></span>
            <small>Letters and spaces only</small>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" placeholder="e.g., student@example.com" />
            <span asp-validation-for="Email" class="error-message"></span>
        </div>
        <div class="form-group">
            <label asp-for="Phone">Phone</label>
            <input asp-for="Phone" placeholder="e.g., 0912345678" />
            <span asp-validation-for="Phone" class="error-message"></span>
            <small>Numbers only (9–15 digits)</small>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="Department">Department</label>
        <input asp-for="Department" placeholder="e.g., Computer Science" />
        <span asp-validation-for="Department" class="error-message"></span>
        <small>Letters and spaces only</small>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Register Student</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
