@model List<dprmitory.Models.DailyReport>

@{
    ViewData["Title"] = "Daily Reports";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-file-earmark-text"></i> Daily Reports</h2>
        <a asp-controller="Director" asp-action="Dashboard" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> No daily reports have been submitted yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Report Date</th>
                        <th>Prepared By</th>
                        <th>Status</th>
                        <th>Students (P/A)</th>
                        <th>Rooms (O/A)</th>
                        <th>Check-ins/Outs</th>
                        <th>Submitted At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in Model)
                    {
                        <tr>
                            <td>@report.ReportDate.ToString("MMM dd, yyyy")</td>
                            <td>@report.PreparedBy</td>
                            <td>
                                @if (report.Status == dprmitory.Models.ReportStatus.Draft)
                                {
                                    <span class="badge bg-secondary">Draft</span>
                                }
                                else if (report.Status == dprmitory.Models.ReportStatus.Submitted)
                                {
                                    <span class="badge bg-primary">Submitted</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Reviewed</span>
                                }
                            </td>
                            <td>
                                <span class="text-success">@report.StudentsPresent</span> / 
                                <span class="text-danger">@report.StudentsAbsent</span>
                            </td>
                            <td>
                                <span class="text-info">@report.OccupiedRooms</span> / 
                                <span class="text-secondary">@report.AvailableRooms</span>
                            </td>
                            <td>
                                <i class="bi bi-arrow-down-circle text-success"></i> @report.CheckInsToday / 
                                <i class="bi bi-arrow-up-circle text-danger"></i> @report.CheckOutsToday
                            </td>
                            <td>@report.CreatedAt.ToString("MMM dd, HH:mm")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@report.Id" class="btn btn-sm btn-info" title="View Details">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                @if (report.Status == dprmitory.Models.ReportStatus.Submitted)
                                {
                                    <form asp-action="MarkReviewed" asp-route-id="@report.Id" method="post" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-success" title="Mark as Reviewed">
                                            <i class="bi bi-check-circle"></i> Review
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
