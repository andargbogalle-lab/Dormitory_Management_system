@model dynamic

@{
    ViewData["Title"] = "Reports";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-graph-up"></i> Dormitory Reports</h2>
        <a asp-action="Dashboard" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h5>Room Occupancy Report</h5>
        </div>
        <div class="card-body">
            <p><strong>Overall Occupancy Rate:</strong> @Model.OccupancyRate.ToString("F2")%</p>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Room</th>
                        <th>Type</th>
                        <th>Capacity</th>
                        <th>Current</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var room in Model.Rooms)
                    {
                        <tr>
                            <td>@room.RoomNumber</td>
                            <td>@room.Type</td>
                            <td>@room.Capacity</td>
                            <td>@room.CurrentOccupancy</td>
                            <td><span class="badge bg-secondary">@room.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h5>Student Status Summary</h5>
        </div>
        <div class="card-body">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Student ID</th>
                        <th>Name</th>
                        <th>Room</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model.Students)
                    {
                        <tr>
                            <td>@student.StudentId</td>
                            <td>@student.FullName</td>
                            <td>@(student.Room?.RoomNumber ?? "N/A")</td>
                            <td><span class="badge bg-@(student.Status == dprmitory.Models.AvailabilityStatus.Present ? "success" : "secondary")">@student.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
